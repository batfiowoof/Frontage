# TypeSafe AI (Jev) -- scores decisions for the AI opponent.
#
# Entirely optional. With no key here the AI falls back to the heuristics in
# sim/ai.gd and plays exactly as it did before Jev existed, so every gate
# (test.cmd, nettest.cmd, camptest.cmd, aitest.cmd) runs green without one.
#
# Key from https://console.typesafe.ai/settings/keys
#
# A real environment variable wins over this file, which is the only sane path
# for anything exported -- res://.env is packed into the PCK.

TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
