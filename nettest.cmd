@echo off
REM Two-process networked proof (M3/M4). The joining client is the judge.
set "RTSPROJ=%~dp0."
powershell -NoProfile -ExecutionPolicy Bypass -Command "$godot = 'C:\Users\bojid\Downloads\Godot_v4.7.2-stable_win64.exe\Godot_v4.7.2-stable_win64.exe';$q = '\"' + $env:RTSPROJ + '\"';$sargs = @('--path', $q, '--headless', '--script', 'res://tests/net_harness.gd', '--');$ho = Join-Path $env:TEMP 'rts_host.log'; $he = Join-Path $env:TEMP 'rts_host.err';$co = Join-Path $env:TEMP 'rts_join.log'; $ce = Join-Path $env:TEMP 'rts_join.err';$h = Start-Process -FilePath $godot -ArgumentList ($sargs + '--host') -PassThru -WindowStyle Hidden -RedirectStandardOutput $ho -RedirectStandardError $he;Start-Sleep -Milliseconds 1500;$c = Start-Process -FilePath $godot -ArgumentList ($sargs + @('--join','127.0.0.1')) -PassThru -WindowStyle Hidden -RedirectStandardOutput $co -RedirectStandardError $ce -Wait;$code = $c.ExitCode;Start-Sleep -Milliseconds 800;if (-not $h.HasExited) { Stop-Process -Id $h.Id -Force };Write-Host '=== client (the judge) ==='; Get-Content $co, $ce -ErrorAction SilentlyContinue;Write-Host '=== host ==='; Get-Content $ho, $he -ErrorAction SilentlyContinue;if ($code -eq 0) { Write-Host 'NETTEST PASS' } else { Write-Host ('NETTEST FAIL ' + $code) };exit $code"
exit /b %ERRORLEVEL%
